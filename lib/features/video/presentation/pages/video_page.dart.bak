              type: ImageType.emote,
              src: cover,
              width: width,
              height: height,
              cacheWidth: true,
              getPlaceHolder: () => Center(
                child: Image.asset('assets/images/loading.png'),
              ),
            ),
          ),
        ),
      );
    }
    return const SizedBox.shrink();
  }
}

/// Migrated player visibility widget
///
/// MIGRATION STATUS: ✅ Completed
/// ORIGINAL: Line 1510-1515 Obx()
/// PATTERN: Conditional rendering based on state
class _PlayerVisibilityWidget extends ConsumerWidget {
  const _PlayerVisibilityWidget({
    required this.width,
    required this.height,
    required this.isPipMode,
    required this.isFullScreen,
    required this.isPortrait,
    required this.padding,
    required this.videoDetailController,
    required this.plPlayerController,
    required this.introController,
    required this.heroTag,
    required this.pipNoDanmaku,
    required this.showEpisodes,
    required this.showViewPoints,
    super.key,
  });

  final double width;
  final double height;
  final bool isPipMode;
  final bool isFullScreen;
  final bool isPortrait;
  final EdgeInsets padding;
  final VideoDetailController videoDetailController;
  final PlPlayerController? plPlayerController;
  final CommonIntroController introController;
  final String heroTag;
  final bool pipNoDanmaku;
  final void Function([int?, UgcSeason?, List<ugc.BaseEpisodeItem>?, String?,
      int?, int?, String?]) showEpisodes;
  final void Function() showViewPoints;

  @override
  Widget build(BuildContext context, WidgetRef ref) {
    // Watch state for conditional rendering
    final videoState = ref.watch(
      videoDetailProvider.select((s) => s.videoState),
    );
    final autoPlay = ref.watch(
      videoDetailProvider.select((s) => s.autoPlay),
    );

    // Conditional rendering based on state
    if (videoState is! Success ||
        !autoPlay ||
        plPlayerController?.videoController == null) {
      return const SizedBox.shrink();
